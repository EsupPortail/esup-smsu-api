<?xml version="1.0" encoding="UTF-8" ?>

<beans 
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
	http://www.springframework.org/schema/beans/spring-beans-2.0.xsd">

	<!-- 
		The configuration file for sms services.
		This file is referenced by /properties/applicationContext.xml.
	-->

	<bean
		class="org.esupportail.smsuapi.services.sms.impl.allmysms.SMSSenderAllmysms">
		<description>
			Allmysms implementation of the broker, this class manage the sms sending
		</description>
		<constructor-arg name="account_login" value="${sms.connector.allmysms.account.login}" />
		<constructor-arg name="account_apikey" value="${sms.connector.allmysms.account.apikey}" />
		<constructor-arg name="sendsms_url" value="https://api.allmysms.com/http/9.0/sendSms/" />
		<constructor-arg name="simulate_sendsms_url" value="https://api.allmysms.com/http/9.0/simulateCampaign/" />
		<!--
		<constructor-arg name="simulate_sendsms_url" value="http://localhost:8081/DEBUG/" />
		-->		
		<constructor-arg name="from_mapJSON" value="${sms.connector.allmysms.from.mapJSON}" />
		<constructor-arg name="simulateMessageSending" value="${sms.connector.simulateSending}" />
		<constructor-arg name="restTemplate">
				<bean class="org.springframework.web.client.RestTemplate">
					<property name="messageConverters">
						<list>
							<bean class="org.springframework.http.converter.FormHttpMessageConverter"/>
							<bean class="org.esupportail.smsuapi.services.sms.impl.allmysms.ForcedMappingJacksonHttpMessageConverter"/>
						</list>
					</property>
				</bean>
			</constructor-arg>

	</bean>

	<bean
	    class="org.esupportail.smsuapi.services.sms.impl.allmysms.BackChannelAck">
	</bean>

</beans>
